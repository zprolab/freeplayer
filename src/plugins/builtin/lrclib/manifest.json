{
  "id": "lrclib-lyrics",
  "name": "LRCLIB Lyrics",
  "version": "1.0.0",
  "description": "Fetch synced lyrics from lrclib.net",
  "author": "zprolab",
  "homepage": "https://lrclib.net",
  "apiVersion": 1,
  "main": "main.js",
  "activationEvents": ["lyrics:fetch"],
  "provides": { "lyrics": true },
  "permissions": ["http"],
  "settings": [
    { "key": "minMatchScore", "type": "number", "label": "Min match score", "default": 0.8, "min": 0, "max": 1 },
    { "key": "requestIntervalMs", "type": "number", "label": "Request interval (ms)", "default": 1200, "min": 100, "max": 60000 },
    { "key": "silentCooldown", "type": "boolean", "label": "Silent failures (cooldown on 429/403)", "default": true }
  ]
}
