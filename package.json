{
  "name": "freeplayer",
  "version": "1.2.0",
  "description": "A local music player with metadata tracking and listening statistics",
  "license": "GPL-3.0-or-later",
  "author": "zprolab",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "build": "vite build",
    "bundle": "bash scripts/bundle.sh",
    "dist": "bash scripts/package.sh",
    "install:app": "bash scripts/install.sh",
    "test": "vitest run",
    "lint": "eslint .",
    "test:watch": "vitest",
    "clean": "bash scripts/clean.sh",
    "run:app": "bash scripts/run-app.sh",
    "build:ipad:sim": "bash scripts/build-ios.sh --ipad --simulator",
    "build:iphone:sim": "bash scripts/build-ios.sh --iphone --simulator",
    "build:ipad:device": "bash scripts/build-ios.sh --ipad --no-simulator",
    "build:iphone:device": "bash scripts/build-ios.sh --iphone --no-simulator",
    "build:ipad:ipa": "bash scripts/build-ios.sh --ipad --no-simulator --ipa",
    "build:iphone:ipa": "bash scripts/build-ios.sh --iphone --no-simulator --ipa",
    "test:simulator": "bash scripts/test-simulator.sh",
    "test:simulator:unit": "bash scripts/test-simulator.sh unit",
    "test:simulator:ui": "bash scripts/test-simulator.sh ui"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "lightningcss": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "terser": "^5.49.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.7"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
